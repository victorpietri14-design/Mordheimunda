const D=window.NECROHEIM_CATALOG;
const KEY='necroheim_roster_v4';
let state=JSON.parse(localStorage.getItem(KEY)||'null')||{rosters:[],active:null};
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const P=D.profileNames;
const P_FULL=['Mouvement','Capacité de combat','Capacité de tir','Force','Endurance','Blessures','Initiative','Attaques','Commandement','Calme','Volonté','Intelligence'];
let gangTab='roster';
let editingIndex=null;
let equipmentTab='band';
let equipmentCategoryFilter='all';
const factionSigils={reikland:'♜',middenheim:'☽',averland:'⚜',ostland:'♞',possessed:'☿',witchhunters:'†',sisters:'✠',undead:'☠',skaven:'☣',orcs:'☄',dwarfs:'⚒'};
function save(silent=false){localStorage.setItem(KEY,JSON.stringify(state));if(!silent)toast('Données sauvegardées')}
function toast(t){const x=document.createElement('div');x.className='toast';x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),1800)}
function activeRoster(){const r=state.rosters.find(r=>r.id===state.active);if(r&&!Number.isFinite(r.gold))r.gold=Math.max(0,(faction(r)?.budget||1000)-r.fighters.reduce((n,x)=>n+fighterPaid(x),0));if(r&&!Array.isArray(r.fighters))r.fighters=[];return r}
function faction(r){return D.factions.find(f=>f.id===r.factionId)}
function fighterValue(x){return Number(x.cost||0)+((x.equipmentSelected||[]).reduce((n,e)=>n+Number(e.value ?? e.price ?? 0),0))}
function fighterPaid(x){return Number(x.cost||0)+((x.equipmentSelected||[]).reduce((n,e)=>n+Number(e.paid ?? e.price ?? 0),0))}
function fighterCost(x){return fighterValue(x)}
function total(r){return r.fighters.reduce((n,x)=>n+fighterValue(x),0)}
function render(view='dashboard'){
 document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.view===view));
 const t={dashboard:['NECROHEIM / M17','Accueil'],rosters:['ARCHIVES / WARBANDS','Mes bandes'],create:['FORGE / NEW WARBAND','Créer une bande'],builder:['WAR ROOM / ACTIVE BAND','Roster'],fighter:['WARRIOR / ACTIVE CARD','Fiche du combattant'],armory:['ARMORY / REFERENCE','Arsenal'],codex:['CODEX / M17','Codex M17']}[view]||['NECROHEIM / M17','Accueil'];
 $('#eyebrow').textContent=t[0];$('#pageTitle').textContent=t[1];({dashboard,rosters,create,builder,fighter,armory,codex}[view]||dashboard)();
}
function dashboard(){const active=activeRoster();$('#content').innerHTML=`<div class="landing"><div class="landing-art"><div class="landing-watermark">M17</div><div class="landing-kicker">FAN-MADE · PRIVATE USE · NECROHEIM / MORDMUNDA</div><h2>Build your warband.<br><em>Survive the ruin.</em></h2><p>Un gestionnaire de bandes M17 pensé comme une véritable application de campagne : recrutement, profils, équipement, progression et référence du livre source.</p><div class="landing-actions"><button class="button primary xl" onclick="render('create')">＋ Créer une nouvelle bande</button>${active?`<button class="button glass xl" onclick="openRoster('${active.id}')">⚔ Reprendre ${esc(active.name)}</button>`:`<button class="button glass xl" onclick="render('rosters')">Mes bandes</button>`}</div></div><div class="landing-footer"><div><b>${state.rosters.length}</b><span>bandes locales</span></div><div><b>${D.factions.length}</b><span>factions M17</span></div><div><b>${D.pages.length}</b><span>pages de référence</span></div><div><b>1000</b><span>GC de départ</span></div></div></div><div class="section-head"><div><div class="eyebrow">QUICK ACCESS</div><h3>Créer une bande</h3></div><button class="button secondary" onclick="render('rosters')">Voir mes bandes →</button></div><div class="faction-grid">${D.factions.map(factionTile).join('')}</div>`}
function factionTile(f){return `<button class="faction-tile" onclick="startFaction('${f.id}')"><span class="faction-sigil">${factionSigils[f.id]||'◆'}</span><span class="faction-name">${esc(f.displayName)}</span><span class="faction-sub">${f.warriors.length} profils · ${f.group||'M17'}</span><span class="faction-arrow">→</span></button>`}
function startFaction(fid){render('create');setTimeout(()=>{const el=$(`[data-faction="${fid}"]`);if(el)selectFaction(fid,el)},0)}
function rosters(){$('#content').innerHTML=`<div class="page-intro"><div><div class="eyebrow">WARHOUSE / ARCHIVES</div><h2>Mes bandes</h2><p>Chaque bande reste stockée localement dans ton navigateur. Clique n’importe où sur une carte pour l’ouvrir.</p></div><button class="button primary" onclick="render('create')">＋ Nouvelle bande</button></div>${state.rosters.length?`<div class="roster-grid">${state.rosters.map(rosterCard).join('')}</div>`:`<div class="empty large"><strong>Aucune bande.</strong><span>Commence par choisir une faction et forge ton premier roster.</span><button class="button primary" onclick="render('create')">Créer une bande</button></div>`}`}
function rosterCard(r){const f=faction(r),c=total(r);return `<article class="roster-card-v4 roster-card-clickable" onclick="openRoster('${r.id}')" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openRoster('${r.id}')}"><div class="roster-banner"><span class="faction-sigil small">${factionSigils[f.id]||'◆'}</span><span>${esc(f.displayName)}</span></div><div class="roster-card-body"><div><h3>${esc(r.name)}</h3><div class="roster-meta"><span>${r.fighters.length} guerrier${r.fighters.length!==1?'s':''}</span><span>${c} / ${f.budget||1000} GC</span><span>Réputation ${r.reputation}</span></div></div><div class="roster-card-actions" onclick="event.stopPropagation()"><button class="iconbtn" onclick="duplicateRoster('${r.id}')">Dupliquer</button></div></div></article>`}
function create(){$('#content').innerHTML=`<div class="create-shell"><div class="create-copy"><div class="eyebrow">NEW WARBAND</div><h2>Choisis ta faction.</h2><p>Commence par sélectionner le livre de recrutement de ta bande. Les profils, coûts et limites seront ensuite chargés directement dans le roster.</p><div class="create-rule"><span>01</span><div><b>Faction</b><small>Une bande · une identité · un arsenal</small></div></div><div class="create-rule"><span>02</span><div><b>Nom de bande</b><small>Tu pourras le modifier à tout moment</small></div></div><div class="create-rule"><span>03</span><div><b>Roster</b><small>Recrute tes Leaders, Champions, Raw Recruits et Henchmen</small></div></div></div><div class="create-panel"><div class="panel-head"><div><div class="eyebrow">STEP 01 / 02</div><h3>Faction</h3></div><span class="step-count">${D.factions.length} DISPONIBLES</span></div><div class="faction-select-grid">${D.factions.map((f,i)=>`<button class="faction-choice ${i===0?'selected':''}" data-faction="${f.id}" onclick="selectFaction('${f.id}',this)"><span class="choice-sigil">${factionSigils[f.id]||'◆'}</span><span><b>${esc(f.displayName)}</b><small>${f.warriors.length} profils structurés</small></span><i>›</i></button>`).join('')}</div><div class="name-step"><label for="createName">Nom de la bande</label><input id="createName" placeholder="Ex. Les Enfants de la Crypte" value=""><button class="button primary xl full" onclick="createFromPage()">Continuer →</button></div></div></div>`}
let selectedFaction=D.factions[0]?.id;
function selectFaction(fid,el){selectedFaction=fid;document.querySelectorAll('.faction-choice').forEach(x=>x.classList.remove('selected'));el.classList.add('selected')}
function createFromPage(){const f=D.factions.find(x=>x.id===selectedFaction);const name=($('#createName').value||'').trim()||`Bande ${f.displayName}`;const id=crypto.randomUUID();state.rosters.push({id,name,factionId:f.id,fighters:[],gold:f.budget,reputation:1});state.active=id;save(true);render('builder')}
function openRoster(id){state.active=id;const r=activeRoster();if(r&&!Number.isFinite(r.gold))r.gold=Math.max(0,(faction(r)?.budget||1000)-r.fighters.reduce((n,x)=>n+fighterPaid(x),0));save(true);gangTab='roster';render('builder')}
function duplicateRoster(id){const r=state.rosters.find(x=>x.id===id),copy=JSON.parse(JSON.stringify(r));copy.id=crypto.randomUUID();copy.name=r.name+' — copie';copy.fighters.forEach(x=>x.instance=crypto.randomUUID());state.rosters.push(copy);state.active=copy.id;save();render('builder')}
function builder(){const r=activeRoster();if(!r){render('create');return}const f=faction(r),value=total(r),isRecruit=gangTab==='recruit';$('#content').innerHTML=`<div class="warroom"><div class="warroom-head"><div><div class="faction-line"><span class="faction-sigil small">${factionSigils[f.id]||'◆'}</span><span>${esc(f.displayName)}</span></div><h2>${esc(r.name)}</h2><div class="roster-meta"><span>${r.fighters.length} guerrier${r.fighters.length!==1?'s':''}</span><span>Valeur ${value} GC</span><span>Réputation ${r.reputation}</span></div></div><div class="warroom-actions"><button class="button secondary" onclick="render('rosters')">← Mes bandes</button><button class="button danger" onclick="deleteRoster('${r.id}')">Supprimer</button></div></div><div class="gang-tabs"><button class="gang-tab ${!isRecruit?'active':''}" onclick="setGangTab('roster')">⚔ Bande <span>${r.fighters.length}</span></button><button class="gang-tab ${isRecruit?'active':''}" onclick="setGangTab('recruit')">＋ Recrutement</button></div><div class="warband-gold card"><div><span class="micro-label">TRÉSOR DE LA BANDE</span><strong>${r.gold} GC</strong><small>Achats et recettes de campagne</small></div><div class="gold-controls"><button class="gold-btn" onclick="adjustGold(-10)">− 10</button><button class="gold-btn" onclick="adjustGold(10)">＋ 10</button><label>Montant<input id="goldAmount" type="number" min="1" step="1" value="10"></label><button class="gold-btn" onclick="adjustGold(-Number($('#goldAmount').value||0))">−</button><button class="gold-btn" onclick="adjustGold(Number($('#goldAmount').value||0))">＋</button></div></div><div class="warroom-grid"><section class="warroom-main">${isRecruit?recruitmentView(f):rosterView(r,f)}</section><aside class="roster-rail"><div class="card rail-card sticky"><div class="rail-total"><span>VALEUR DE LA BANDE</span><strong>${value}</strong><em>${r.gold} GC en trésor</em></div><div class="rail-stats"><div><b>${r.fighters.length}</b><span>Guerriers</span></div><div><b>${r.gold}</b><span>Trésor</span></div><div><b>${r.reputation}</b><span>Réputation</span></div></div><div class="rail-divider"></div><div class="rail-label">ROSTER ACTUEL</div><div class="chosen-list">${r.fighters.length?r.fighters.map((x,i)=>chosenRow(x,i)).join(''):'<div class="empty compact">Aucun guerrier recruté.</div>'}</div><button class="button secondary full" onclick="save()">Sauvegarder</button></div></aside></div></div>`}
function setGangTab(tab){gangTab=tab;render('builder')}
function adjustGold(amount){const r=activeRoster();if(!r)return;const n=Number(amount);if(!Number.isFinite(n)||n===0)return;r.gold=Math.max(0,Math.round(r.gold+n));save(true);render('builder');toast(`${n>0?'+':''}${n} GC`)}
function rosterView(r,f){const groups=['Leader','Champion','Raw Recruit','Henchman'];return `<div class="roster-toolbar"><div><div class="eyebrow">ACTIVE ROSTER</div><h3>Guerriers de la bande</h3><p>Clique sur un combattant pour ouvrir sa fiche complète. Les modifications sont enregistrées automatiquement.</p></div><button class="button primary" onclick="setGangTab('recruit')">＋ Recruter</button></div><div class="roster-sections">${groups.map(type=>{const xs=r.fighters.map((x,i)=>({x,i})).filter(z=>z.x.type===type);if(!xs.length)return '';return `<section class="roster-section"><div class="section-label">${type.toUpperCase()} <span>${xs.length}</span></div><div class="fighter-list">${xs.map(z=>ownedFighterCard(z.x,z.i,f)).join('')}</div></section>`}).join('')}</div>${r.fighters.length?'':'<div class="empty large"><strong>Ta bande est vide.</strong><span>Utilise l’onglet Recrutement pour choisir tes premiers combattants.</span><button class="button primary" onclick="setGangTab(\'recruit\')">Ouvrir le recrutement</button></div>'}`}
function recruitmentView(f){return `<div class="recruit-head"><div><div class="eyebrow">RECRUTEMENT / ${esc(f.displayName)}</div><h3>Recruter un combattant</h3><p>Le recrutement ajoute le combattant à la bande sans ouvrir sa fiche. Ouvre ensuite sa carte depuis le roster.</p></div></div><div class="recruit-select-row"><label>Type de combattant<select id="typeFilter" class="select" onchange="filterFighters()"><option value="">Tous les types</option><option>Leader</option><option>Champion</option><option>Raw Recruit</option><option>Henchman</option></select></label><label class="grow">Rechercher<input id="fighterSearch" class="search" placeholder="Nom du profil…" oninput="filterFighters()"></label></div><div class="fighter-pool" id="fighterPool">${fighterPool(f)}</div>`}
function chosenRow(x,i){return `<button class="chosen-v4" onclick="openFighterCard(${i})"><span class="chosen-sigil">${factionSigils[faction(activeRoster()).id]||'◆'}</span><span class="chosen-info"><b>${esc(x.name)}</b><small>${esc(x.type)} · ${fighterValue(x)} GC</small></span><span class="chosen-open">›</span></button>`}
function profileMarkup(profile,xp){return `<div class="profile-simple"><div class="profile-row">${P.map((n,i)=>`<div class="profile-stat ${i>=8?'mental-stat':''}"><span>${n}</span><i></i><b>${profile[i]}</b></div>`).join('')}<div class="profile-xp"><span>XP</span><i></i><b>${Number(xp||0)}</b></div></div></div>`}
function weaponProfileMarkup(e){const p=e.profile;if(!p)return '';return `<div class="weapon-profile"><div class="weapon-profile-title">${esc(e.name)}</div><div class="weapon-profile-grid"><span>Portée<b>${esc(p.range)}</b></span><span>Force<b>${esc(p.strength)}</b></span><span>AP<b>${esc(p.ap)}</b></span><span>Dégâts<b>${esc(p.damage)}</b></span><span class="weapon-traits">Traits<b>${esc(p.traits||'—')}</b></span></div></div>`}
function ownedFighterCard(x,i,f){const weapons=(x.equipmentSelected||[]).filter(e=>e.profile);return `<article class="fighter-card-v5 owned-card" onclick="openFighterCard(${i})"><div class="fighter-top"><div class="fighter-ident"><div class="fighter-sigil">${factionSigils[f.id]||'◆'}</div><div><div class="fighter-name-line"><h4>${esc(x.name)}</h4><span class="role-badge role-${esc(x.type.toLowerCase().replace(/\s+/g,'-'))}">${esc(x.type)}</span></div><div class="fighter-subline">${fighterValue(x)} GC · ${Number(x.xp||0)} XP</div></div></div><span class="card-chevron">›</span></div>${profileMarkup(x.profile,x.xp)}${weapons.length?`<div class="card-weapons">${weapons.map(weaponProfileMarkup).join('')}</div>`:''}<div class="fighter-card-sections"><div><span class="micro-label">WARGEAR</span><p>${x.equipmentSelected?.length?x.equipmentSelected.filter(e=>!e.profile).map(e=>esc(e.name)).join(' · '):'Aucun'}</p></div><div><span class="micro-label">SKILLS</span><p>${x.skills?.length?x.skills.map(esc).join(' · '):'—'}</p></div><div><span class="micro-label">RÈGLES SPÉCIALES</span><p>${x.rules?esc(x.rules):'—'}</p></div><div><span class="micro-label">LASTING INJURIES</span><p>${x.injuries?.length?x.injuries.map(esc).join(' · '):'Aucune'}</p></div></div><div class="fighter-value-circle"><span>VALEUR</span><strong>${fighterValue(x)}</strong><em>GC</em></div></article>`}
function fighterPool(f){return f.warriors.map(w=>`<article class="fighter-card-v4 fighter-row" data-name="${esc(w.name.toLowerCase())}" data-type="${esc(w.type)}"><div class="fighter-top"><div class="fighter-ident"><div class="fighter-sigil">${factionSigils[f.id]||'◆'}</div><div><div class="fighter-name-line"><h4>${esc(w.name)}</h4><span class="role-badge role-${esc(w.type.toLowerCase().replace(/\s+/g,'-'))}">${esc(w.type)}</span></div><div class="fighter-subline">${w.max!==null?'Maximum '+w.max:'Aucune limite'} · ${w.cost} GC</div></div></div><button class="button primary recruit-btn" onclick="event.stopPropagation();addFighter('${esc(w.id)}')">Recruter</button></div>${profileMarkup(w.profile,0)}<div class="fighter-bottom"><div><span class="micro-label">ÉQUIPEMENT / ACCÈS</span><p>${esc(w.equipment||w.access||'Voir le Codex M17')}</p></div></div></article>`).join('')}
function filterFighters(){const q=($('#fighterSearch')?.value||'').toLowerCase(),t=$('#typeFilter')?.value||'';document.querySelectorAll('.fighter-row').forEach(x=>x.style.display=(!q||x.dataset.name.includes(q))&&(!t||x.dataset.type===t)?'block':'none')}
function addFighter(wid){const r=activeRoster(),f=faction(r),w=f.warriors.find(x=>x.id===wid);if(!w)return;const count=r.fighters.filter(x=>x.wid===wid).length;if(w.max!==null&&count>=w.max){toast('Limite atteinte pour ce profil');return}if(r.gold<w.cost){toast('Trésor insuffisant');return}r.fighters.push({...w,wid,instance:crypto.randomUUID(),name:w.name,xp:0,equipmentSelected:[],skills:[],injuries:[],notes:''});r.gold-=Number(w.cost||0);save(true);gangTab='roster';render('builder');toast(`${w.name} recruté`)}
function openFighterCard(index){const r=activeRoster();if(!r||!r.fighters[index])return;editingIndex=index;equipmentTab='band';equipmentCategoryFilter='all';render('fighter')}
function fighter(){const r=activeRoster();const x=r?.fighters[editingIndex];if(!r||!x){render('builder');return}$('#content').innerHTML=fighterPageMarkup(x)}
function equipmentCategory(w){return w.category||'Équipements divers'}
function equipmentPool(tab,x){const f=faction(activeRoster());let ws=D.weapons.slice();if(tab==='band')ws=ws.filter(w=>w.bandByFaction?.[f.id]||w.band);else if(tab==='market')ws=ws.filter(w=>w.market!==false);if(equipmentCategoryFilter!=='all')ws=ws.filter(w=>equipmentCategory(w)===equipmentCategoryFilter);return ws}
function equipmentPrice(w,f,tab=equipmentTab){if(tab==='band'&&w.bandPrices?.[f.id]!=null)return Number(w.bandPrices[f.id]);return w.price}
function weaponSlots(e){if(e?.weaponSlotCost!=null)return Number(e.weaponSlotCost);const t=(e?.profile?.traits||'').toLowerCase();if(/two[- ]handed/.test(t))return 2;if(['Shield','Buckler','Main Gauche','Left hand dagger','Sword breaker'].includes(e?.name))return 1;if(/paired/.test(t))return 2;if(e?.name==='Unarmed'||e?.name==='Natural Weapons'||e?.name==='Tail Blade')return 0;return e?.profile?1:0}
function currentWeaponSlots(x){return (x.equipmentSelected||[]).reduce((n,e)=>n+weaponSlots(e),0)}
function isWeaponLike(w){return !!w.profile&&w.category!=='Équipements divers'&&w.category!=='Animaux'}
function canEquip(x,w){if(isWeaponLike(w)){const slots=weaponSlots(w);if(currentWeaponSlots(x)+slots>3)return {ok:false,msg:'Maximum de 3 emplacements d’armes atteint (les armes à deux mains comptent pour 2).'} }if(w.category==='Armure'&&(x.equipmentSelected||[]).some(e=>e.category==='Armure'&&e.name!==w.name))return {ok:false,msg:'Un combattant ne peut porter qu’une seule armure.'};return {ok:true}}
function equipmentPicker(x,equip){const f=faction(activeRoster()),tabs=[['band','Band List'],['market','Market List'],['unrestricted','Unrestricted List']];const cats=['all',...new Set(D.weapons.map(equipmentCategory))];const ws=equipmentPool(equipmentTab,x).filter(w=>!equip.some(e=>e.name===w.name));return `<div class="equipment-picker"><div class="equipment-tabs">${tabs.map(([id,label])=>`<button type="button" class="equipment-tab ${equipmentTab===id?'active':''}" onclick="setEquipmentTab('${id}')">${label}<span>${equipmentPool(id,x).length}</span></button>`).join('')}</div><div class="equipment-categories">${cats.map(c=>`<button type="button" class="equipment-cat ${equipmentCategoryFilter===c?'active':''}" onclick="setEquipmentCategory('${c}')">${c==='all'?'Toutes':c}</button>`).join('')}</div><div class="equipment-market-list">${ws.length?ws.map(w=>`<button type="button" class="equipment-choice" onclick="confirmEquipment('${encodeURIComponent(w.name)}')"><span><b>${esc(w.name)}</b><small>${esc(equipmentCategory(w))}${w.availability&&w.availability!=='—'?' · '+esc(w.availability):''}</small></span><strong>${equipmentPrice(w,f,equipmentTab)==null?'—':equipmentPrice(w,f,equipmentTab)+' GC'}</strong></button>`).join(''):'<div class="empty compact">Aucun équipement dans cette liste.</div>'}</div></div>`}
function fighterPageMarkup(x){const f=faction(activeRoster()),equip=x.equipmentSelected||[],weapons=equip.filter(e=>e.profile),wargear=equip.filter(e=>!e.profile);return `<div class="fighter-page"><div class="fighter-page-top"><button class="button secondary" onclick="backToGang()">← Retour à la bande</button><div class="fighter-page-actions"><button class="button danger-outline" onclick="removeEditingFighter()">Supprimer le combattant</button></div></div><div class="fighter-page-header"><div><div class="eyebrow">FICHE DU COMBATTANT · ${esc(f.displayName)}</div><div class="fighter-title-row"><input id="fighterName" class="sheet-name" value="${esc(x.name)}" onchange="updateFighterField('name',this.value)"><span class="role-badge role-${esc(x.type.toLowerCase().replace(/\s+/g,'-'))}">${esc(x.type)}</span></div><div class="sheet-sub">Profil de base · ${x.cost} GC · modifications enregistrées automatiquement</div></div><div class="fighter-value-circle hero-value"><span>VALEUR</span><strong>${fighterValue(x)}</strong><em>GC</em></div></div>${profileMarkup(x.profile,x.xp)}<div class="fighter-detail-grid"><section class="sheet-block weapons-block"><div class="sheet-block-head"><h4>Armes</h4><span>${currentWeaponSlots(x)} / 3 emplacements</span></div>${weapons.length?weapons.map(weaponProfileMarkup).join(''):'<div class="empty compact">Aucune arme équipée.</div>'}</section><section class="sheet-block"><div class="sheet-block-head"><h4>Wargear</h4><span>${wargear.length} objet${wargear.length!==1?'s':''}</span></div><div class="equipment-list">${wargear.length?wargear.map((e,i)=>`<div class="equipment-item"><span>${esc(e.name)}</span><div><strong>${Number(e.paid??e.price??0)} GC</strong><small>valeur ${Number(e.value??e.price??0)} GC</small></div><button type="button" onclick="removeEquipment(${equip.indexOf(e)})">×</button></div>`).join(''):'<div class="empty compact">Aucun wargear.</div>'}</div></section><section class="sheet-block equipment-add-block"><div class="sheet-block-head"><h4>Ajouter de l’équipement</h4><span>3 listes</span></div><p class="sheet-help">Un clic sur un objet ouvre une confirmation d’achat. Le prix payé et la valeur affichée peuvent être différents.</p>${equipmentPicker(x,equip)}</section><section class="sheet-block"><div class="sheet-block-head"><h4>Progression</h4></div><div class="field-inline"><label>XP actuel<input id="fighterXp" type="number" min="0" step="1" value="${Number(x.xp||0)}" onchange="updateFighterField('xp',this.value)"></label></div><div class="field"><label>Skills</label><div class="tag-editor">${x.skills?.length?x.skills.map((s,i)=>`<span>${esc(s)}<button type="button" onclick="removeSkill(${i})">×</button></span>`).join(''): '<small>Aucune compétence enregistrée.</small>'}</div><div class="inline-add"><input id="skillInput" placeholder="Ajouter une compétence"><button type="button" class="button secondary" onclick="addSkill()">Ajouter</button></div></div></section><section class="sheet-block"><div class="sheet-block-head"><h4>Règles spéciales</h4></div><textarea id="fighterRules" class="wide-textarea" rows="6" placeholder="Règles spéciales…" onchange="updateFighterField('rules',this.value)">${esc(x.rules||'')}</textarea></section><section class="sheet-block"><div class="sheet-block-head"><h4>Lasting Injuries</h4></div><div class="tag-editor">${x.injuries?.length?x.injuries.map((s,i)=>`<span>${esc(s)}<button type="button" onclick="removeInjury(${i})">×</button></span>`).join(''):'<small>Aucune séquelle enregistrée.</small>'}</div><div class="inline-add"><input id="injuryInput" placeholder="Ajouter une séquelle"><button type="button" class="button secondary" onclick="addInjury()">Ajouter</button></div></section><section class="sheet-block"><div class="sheet-block-head"><h4>Notes de campagne</h4></div><textarea id="fighterNotes" class="wide-textarea" rows="6" placeholder="Notes…" onchange="updateFighterField('notes',this.value)">${esc(x.notes||'')}</textarea></section></div></div>`}
function backToGang(){save(true);render('builder')}
function setEquipmentTab(tab){equipmentTab=tab;equipmentCategoryFilter='all';render('fighter')}
function setEquipmentCategory(cat){equipmentCategoryFilter=cat;render('fighter')}
function confirmEquipment(encoded){const name=decodeURIComponent(encoded),x=activeRoster().fighters[editingIndex],f=faction(activeRoster()),w=D.weapons.find(a=>a.name===name);if(!w)return;const check=canEquip(x,w);if(!check.ok){toast(check.msg);return}const defaultPrice=equipmentPrice(w,f,equipmentTab);openPurchaseConfirm(w,defaultPrice,equipmentTab)}
function openPurchaseConfirm(w,defaultPrice,tab){const source=tab==='band'?'Band List':tab==='market'?'Market List':'Unrestricted List';const canBuy=defaultPrice!=null;openModal(`<div class="purchase-dialog"><div class="eyebrow">ACHAT D’ÉQUIPEMENT · ${source}</div><h2>${esc(w.name)}</h2><p>Confirme l’achat et, si nécessaire, modifie le prix réellement payé. La valeur affichée peut rester différente.</p><div class="purchase-grid"><label>Prix d’achat payé (GC)<input id="purchasePaid" type="number" min="0" step="1" value="${canBuy?Number(defaultPrice):0}"></label><label>Valeur affichée (GC)<input id="purchaseValue" type="number" min="0" step="1" value="${canBuy?Number(defaultPrice):0}"></label></div><label class="toggle-line"><input id="sameValue" type="checkbox" checked onchange="syncPurchaseValue()"><span>Utiliser le prix d’achat comme valeur affichée</span></label><div class="purchase-actions"><button type="button" class="button secondary" onclick="closeModal()">Annuler</button><button type="button" class="button primary" onclick="purchaseEquipment('${encodeURIComponent(w.name)}','${tab}')">Confirmer l’achat</button></div></div>`)}
function syncPurchaseValue(){const p=$('#purchasePaid'),v=$('#purchaseValue');if($('#sameValue')?.checked&&p&&v)v.value=p.value}
function purchaseEquipment(encoded,tab){const r=activeRoster(),x=r?.fighters[editingIndex],f=faction(r),w=D.weapons.find(a=>a.name===decodeURIComponent(encoded));if(!r||!x||!w)return;const paid=Math.max(0,Number($('#purchasePaid')?.value||0)),value=Math.max(0,Number($('#purchaseValue')?.value||0));if(!Number.isFinite(paid)||!Number.isFinite(value)){toast('Prix invalide');return}const check=canEquip(x,w);if(!check.ok){closeModal();toast(check.msg);return}if(r.gold<paid){toast(`Trésor insuffisant : ${r.gold} GC disponibles`);return}x.equipmentSelected=x.equipmentSelected||[];x.equipmentSelected.push({name:w.name,paid,value,price:value,category:w.category,availability:w.availability||'—',profile:w.profile||null,weaponSlotCost:weaponSlots(w)});r.gold-=paid;save(true);closeModal();render('fighter');toast(`${w.name} ajouté`)}
function removeEquipment(i){const r=activeRoster(),x=r?.fighters[editingIndex];if(!x)return;const e=x.equipmentSelected?.[i];if(!e)return;if(!confirm(`Retirer « ${e.name} » de la fiche ? Le prix ne sera pas remboursé.`))return;x.equipmentSelected.splice(i,1);save(true);render('fighter')}
function updateFighterField(key,val){const x=activeRoster()?.fighters[editingIndex];if(!x)return;x[key]=key==='xp'?Math.max(0,Number(val)||0):val;save(true);if(key!=='xp')render('fighter');else toast('XP mis à jour')}
function addSkill(){const x=activeRoster()?.fighters[editingIndex],v=($('#skillInput')?.value||'').trim();if(!x||!v)return;x.skills=x.skills||[];x.skills.push(v);save(true);render('fighter')}
function removeSkill(i){const x=activeRoster()?.fighters[editingIndex];if(!x)return;x.skills.splice(i,1);save(true);render('fighter')}
function addInjury(){const x=activeRoster()?.fighters[editingIndex],v=($('#injuryInput')?.value||'').trim();if(!x||!v)return;x.injuries=x.injuries||[];x.injuries.push(v);save(true);render('fighter')}
function removeInjury(i){const x=activeRoster()?.fighters[editingIndex];if(!x)return;x.injuries.splice(i,1);save(true);render('fighter')}
function saveFighterCard(){save(true);toast('Fiche enregistrée automatiquement')}
function removeEditingFighter(){const r=activeRoster(),x=r?.fighters[editingIndex];if(!r||!x)return;openModal(`<div class="delete-dialog"><div class="eyebrow">ACTION IRRÉVERSIBLE</div><h2>Supprimer ${esc(x.name)} ?</h2><p>Ce combattant et les informations de sa fiche seront retirés de la bande. L’équipement acheté n’est pas remboursé.</p><button type="button" class="big-delete" onclick="confirmRemoveEditingFighter()">SUPPRIMER DÉFINITIVEMENT LE COMBATTANT</button><button type="button" class="button secondary full" onclick="closeModal()">Annuler</button></div>`)}
function confirmRemoveEditingFighter(){const r=activeRoster();if(!r)return;r.fighters.splice(editingIndex,1);save(true);closeModal();render('builder');toast('Combattant supprimé')}
function deleteRoster(id){if(confirm('Supprimer définitivement cette bande ?')){state.rosters=state.rosters.filter(r=>r.id!==id);state.active=state.rosters[0]?.id||null;save(true);render('rosters')}}
function openModal(html){$('#modalContent').innerHTML=html;$('#modal').classList.remove('hidden');setTimeout(()=>document.querySelector('#modal input')?.focus(),20)}
function closeModal(){$('#modal').classList.add('hidden')}

function armory(){const cats=[...new Set(D.weapons.map(w=>w.category))].filter(Boolean);$('#content').innerHTML=`<div class="card"><div class="toolbar"><input class="search" id="weaponSearch" placeholder="Rechercher une arme, armure ou équipement…" oninput="renderArmory()"><select class="select" id="weaponType" onchange="renderArmory()"><option value="">Toutes les catégories</option>${cats.map(x=>`<option>${esc(x)}</option>`).join('')}</select></div><div class="armory-wrap"><div id="armoryTable"></div></div></div>`;renderArmory()}
function renderArmory(){const q=($('#weaponSearch')?.value||'').toLowerCase(),t=$('#weaponType')?.value||'',ws=D.weapons.filter(w=>(!q||w.name.toLowerCase().includes(q))&&(!t||w.category===t));$('#armoryTable').innerHTML=`<table class="armory-table"><thead><tr><th>Objet</th><th>Catégorie</th><th>Prix trouvé</th></tr></thead><tbody>${ws.map(w=>`<tr><td><strong>${esc(w.name)}</strong></td><td>${esc(w.category)}</td><td>${w.price===null?'—':w.price+' GC'}</td></tr>`).join('')}</tbody></table>`}
function codex(){const sections=D.rulesMeta;$('#content').innerHTML=`<div class="codex-layout"><aside class="card codex-nav"><button class="active" onclick="showCodex('all',this)">Tout le livre</button>${sections.map((s,i)=>`<button onclick="showCodex(${i},this)">${esc(s[0])}</button>`).join('')}<button onclick="showCodex('factions',this)">Factions</button></aside><section class="card codex-content"><input class="search rule-search" id="bookSearch" placeholder="Rechercher dans les ${D.pages.length} pages…" oninput="searchBook()"><div id="codexBody">${bookPages(D.pages.slice(0,5))}<div class="notice">Le livre complet est embarqué dans <code>data/catalog.js</code>.</div></div></section></div>`}
function bookPages(ps){return ps.map(p=>`<article class="book-page"><h4>Page source ${p.page}</h4><pre>${esc(p.text)}</pre></article>`).join('')}
function searchBook(){const q=$('#bookSearch').value.trim().toLowerCase();if(!q){$('#codexBody').innerHTML=bookPages(D.pages.slice(0,5));return}const hits=D.pages.filter(p=>p.text.toLowerCase().includes(q));$('#codexBody').innerHTML=hits.length?bookPages(hits.slice(0,40)):`<div class="empty">Aucun résultat pour « ${esc(q)} ».</div>`}
function showCodex(key,btn){document.querySelectorAll('.codex-nav button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');if(key==='factions'){$('#codexBody').innerHTML=D.factions.map(f=>`<article class="book-page"><h4>${esc(f.displayName)} · source p.${f.startPage||'—'}</h4><pre>${esc(f.text)}</pre></article>`).join('');return}if(key==='all'){$('#codexBody').innerHTML=bookPages(D.pages.slice(0,5))+'<div class="notice">Utilise la recherche pour parcourir le livre complet.</div>';return}const [name,desc]=D.rulesMeta[key];const hits=D.pages.filter(p=>p.text.toLowerCase().includes(name.toLowerCase())||p.text.toLowerCase().includes(desc.split(',')[0].toLowerCase()));$('#codexBody').innerHTML=`<div class="notice"><strong>${esc(name)}</strong> — ${esc(desc)}</div>`+bookPages(hits.slice(0,40))}
function exportRoster(){const r=activeRoster();if(!r){toast('Aucune bande active');return}const f=faction(r),lines=[`NECROHEIM — ${r.name}`,`Faction: ${f.displayName}`,`Budget initial: ${f.budget} GC`,`Réputation: ${r.reputation}`,'','GUERRIERS'];r.fighters.forEach(x=>lines.push(`${x.name} — ${x.type} — ${fighterCost(x)} GC — ${x.profile.join('/')}`));lines.push('',`Total: ${total(r)} GC`,`Restant: ${f.budget-total(r)} GC`);const blob=new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=r.name.replace(/[^a-z0-9-_]+/gi,'_')+'.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
$('#modalClose').onclick=closeModal;$('#modal').onclick=e=>{if(e.target.id==='modal')closeModal()};$('#saveBtn').onclick=save;$('#exportBtn').onclick=exportRoster;$('#resetBtn').onclick=()=>{if(confirm('Effacer toutes les bandes locales ?')){localStorage.removeItem(KEY);state={rosters:[],active:null};render('dashboard')}};document.querySelectorAll('.nav').forEach(n=>n.onclick=()=>render(n.dataset.view));render('dashboard');
