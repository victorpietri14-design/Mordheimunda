ppercase;color:#aaa}.role-leader{color:#dfc36f;border-color:#5a4d2e}.role-champion{color:#c7a97a;border-color:#504534}.role-raw-recruit{color:#9fb7a6;border-color:#34463b}.role-henchman{color:#9ca5b0}.profile{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;margin:12px 0}.profile-group{border:1px solid #292e35;background:#0d1013;overflow:hidden}.profile-group-title{padding:4px 7px;border-bottom:1px solid #242931;color:#6f767f;font-size:7px;text-transform:uppercase;letter-spacing:.9px}.profile-stats{display:grid;grid-template-columns:repeat(4,1fr)}.profile-stat{text-align:center;padding:6px 2px;border-right:1px solid #252a31}.profile-stat:last-child{border-right:0}.profile-stat b{display:block;font:700 8px Inter;color:#8e959e}.profile-stat span{display:block;font:800 18px/1 'Barlow Condensed';margin-top:3px;color:#f0f0ed}.profile-stat:hover{background:#181b20}.profile-stat[title]{cursor:help}.portrait{width:48px;height:48px;background:linear-gradient(135deg,#332f25,#17191d);border:1px solid #4c4637;display:grid;place-items:center;font:700 23px 'Barlow Condensed';color:#bba46b}.fighter h4{font:700 19px 'Barlow Condensed';margin:0}.fighter small{color:#777d85;font-size:9px}.profile{display:grid;grid-template-columns:repeat(12,minmax(22px,1fr));gap:3px;margin:10px 0}.cost{text-align:right;font:700 18px 'Barlow Condensed';color:#d5b15a}.summary{display:grid;grid-template-columns:1fr 1fr;gap:6px}.box{border:1px solid #292e35;background:#0d1013;padding:11px}.box span{display:block;color:#70767e;font-size:8px;text-transform:uppercase;letter-spacing:.8px}.box strong{display:block;font:700 24px 'Barlow Condensed';margin-top:3px}.danger{color:var(--danger)!important}.notice{border:1px solid #3b372d;background:#17150f;color:#aaa08b;padding:12px;font-size:10px;line-height:1.5;margin-top:12px}.side-title{font:700 22px 'Barlow Condensed';margin:0 0 13px}.roster-list{margin-top:13px;max-height:390px;overflow:auto}.chosen{display:flex;justify-content:space-between;border-bottom:1px solid #262a30;padding:9px 0;font-size:11px}.chosen small{display:block;color:#6f757c;font-size:8px}.chosen button{border:0;background:none;color:#b36c68;cursor:pointer}.armory-wrap{overflow:auto}.armory-table{width:100%;border-collapse:collapse;font-size:10px}.armory-table th{color:#70767e;text-align:left;font-size:8px;text-transform:uppercase;letter-spacing:.8px;padding:11px;background:#0d1013;position:sticky;top:0}.armory-table td{padding:10px;border-top:1px solid #252930;white-space:nowrap}.armory-table tr:hover td{background:#171a1f}.codex-layout{display:grid;grid-template-columns:260px 1fr;gap:12px}.codex-nav{padding:10px}.codex-nav button{width:100%;padding:10px;background:transparent;color:#9da2aa;border:0;border-bottom:1px solid #24282e;text-align:left;cursor:pointer;font:600 11px Inter}.codex-nav button.active,.codex-nav button:hover{color:#e4c77f;background:#171a1e}.codex-content{min-height:650px;padding:24px}.rule-search{margin-bottom:14px}.book-page{border-top:1px solid #2a2e34;padding:20px 0}.book-page h4{font:700 21px 'Barlow Condensed';margin:0 0 8px;color:#d8c18a}.book-page pre{font:11px/1.55 Inter;white-space:pre-wrap;color:#aeb2b8;margin:0;font-family:Inter}.faction-card{padding:18px;margin-bottom:9px}.faction-card h3{font:700 24px 'Barlow Condensed';margin:0 0 3px}.faction-meta{color:#747a82;font-size:10px}.faction-card .warriors-mini{margin-top:14px;display:flex;flex-wrap:wrap;gap:5px}.chip{border:1px solid #30343a;background:#101216;padding:6px 8px;font-size:9px;color:#b8bdc4}.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:50;display:grid;place-items:center;padding:20px}.modal.hidden{display:none}.modal-card{position:relative;background:#12151a;border:1px solid #3b4048;width:min(720px,100%);max-height:90vh;overflow:auto;padding:25px;box-shadow:var(--shadow)}.modal-close{position:absolute;right:12px;top:8px;border:0;background:none;color:#888;font-size:28px;cursor:pointer}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field label{display:block;color:#777d85;font-size:9px;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}.field{margin-bottom:10px}.toast{position:fixed;right:22px;bottom:22px;z-index:80;background:#191b20;border:1px solid #4d4a3f;padding:11px 15px;color:#ddd;font-size:11px;box-shadow:var(--shadow)}
@media(max-width:1000px){.sidebar{width:210px}.main{margin-left:210px;padding:22px}.builder{grid-template-columns:1fr}.sticky{position:static}.span3{grid-column:span 6}.codex-layout{grid-template-columns:1fr}.codex-nav{display:flex;overflow:auto}.codex-nav button{min-width:150px}}
@media(max-width:700px){.sidebar{position:static;width:100%;height:auto;border-right:0;border-bottom:1px solid var(--line);padding:12px}.brand{padding-bottom:12px}.source-pill,.side-bottom{display:none}nav{display:flex;overflow:auto}.nav{white-space:nowrap}.main{margin-left:0;padding:16px}.topbar{height:auto;gap:12px;flex-direction:column}.top-actions{width:100%}.top-actions .button{flex:1}.hero{padding:28px 22px}.hero h2{font-size:52px}.grid{display:grid}.span3,.span4,.span5,.span6,.span7,.span8{grid-column:span 12}.fighter{grid-template-columns:42px 1fr}.fighter .cost{grid-column:2;text-align:left}.profile{grid-template-columns:1fr}.profile-stats{grid-template-columns:repeat(4,1fr)}.profile-role{display:none}.toolbar{flex-direction:column}.select{max-width:none}.form-grid{grid-template-columns:1fr}}
/* ===== V4 / Munda-inspired application shell ===== */
:root{--bg:#08090b;--panel:#101216;--panel2:#171a1f;--line:#2b3038;--text:#ecece8;--muted:#858b94;--accent:#d6b45d;--accent2:#8e6c2c;--danger:#d9655d;--ok:#79b890;--shadow:0 24px 70px rgba(0,0,0,.38)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#08090b;color:var(--text);font-family:Inter,system-ui,sans-serif}body{overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");z-index:99}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:248px;background:linear-gradient(180deg,#101216,#090a0c);border-right:1px solid #252930;padding:24px 14px;display:flex;flex-direction:column;z-index:10}.brand{display:flex;align-items:center;gap:12px;padding:4px 9px 24px;cursor:pointer}.brand-mark{width:42px;height:42px;border:1px solid #625435;display:grid;place-items:center;font:900 28px 'Barlow Condensed';color:var(--accent);background:radial-gradient(circle at 40% 35%,#2d281c,#111)}.brand strong,.brand span{display:block}.brand strong{font:900 26px 'Barlow Condensed';letter-spacing:1.3px}.brand span{font-size:8px;letter-spacing:2.7px;color:#747a82;margin-top:-2px}.source-pill{font:700 8px Inter;letter-spacing:1px;color:#aaa18d;border:1px solid #353229;padding:9px;margin:0 8px 20px;background:#14130f}.source-pill span{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:7px}nav{display:grid;gap:4px}.nav{border:1px solid transparent;background:transparent;color:#858b94;padding:13px 12px;text-align:left;display:flex;align-items:center;gap:12px;border-radius:5px;cursor:pointer;font:600 12px Inter;transition:.18s}.nav i{font-style:normal;width:18px;text-align:center;color:#6f747c;font-size:15px}.nav:hover{background:#17191e;color:#eee}.nav.active{background:linear-gradient(90deg,#211f19,#15171b);border-color:#3b362b;color:#fff;box-shadow:inset 2px 0 0 var(--accent)}.nav.active i{color:var(--accent)}.side-bottom{margin-top:auto}.version{font:600 8px 'Barlow Condensed';letter-spacing:1.4px;color:#5f646b;padding:0 9px 10px}.ghost{width:100%;border:1px solid #292d34;background:transparent;color:#696f77;padding:9px;cursor:pointer;font:600 9px Inter}
.main{margin-left:248px;min-height:100vh;padding:28px 42px 70px;background:radial-gradient(circle at 70% -15%,rgba(113,93,43,.13),transparent 30%)}.topbar{height:60px;display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.eyebrow{font:800 8px Inter;letter-spacing:2.2px;color:#6e747d;margin-bottom:5px;text-transform:uppercase}.topbar h1{font:700 33px 'Barlow Condensed';margin:0}.top-actions{display:flex;gap:8px}.button{border:1px solid #30353d;padding:10px 15px;color:#ddd;background:#171a1f;cursor:pointer;font:800 10px Inter;text-transform:uppercase;letter-spacing:.7px;border-radius:4px;transition:.18s}.button:hover{filter:brightness(1.15);transform:translateY(-1px)}.button.primary{background:linear-gradient(180deg,#d9bb68,#aa893e);border-color:#ddc06c;color:#17130a}.button.secondary{background:#13161b}.button.glass{background:rgba(255,255,255,.035);border-color:#444951}.button.danger{border-color:#62302e;color:#df776e;background:#1a1112}.button.xl{padding:14px 18px;font-size:10px}.button.full{width:100%}
.landing{border:1px solid #38362e;background:linear-gradient(112deg,rgba(37,34,26,.98),rgba(13,15,18,.98) 72%);box-shadow:var(--shadow);overflow:hidden}.landing-art{min-height:390px;padding:60px 62px 42px;position:relative}.landing-art:before{content:'';position:absolute;right:-60px;top:-130px;width:580px;height:580px;border:1px solid rgba(214,180,93,.08);border-radius:50%;box-shadow:0 0 0 55px rgba(214,180,93,.018),0 0 0 110px rgba(214,180,93,.012)}.landing-watermark{position:absolute;right:35px;bottom:-55px;font:900 260px/1 'Barlow Condensed';color:rgba(214,180,93,.045);pointer-events:none}.landing-kicker{position:relative;color:#a99b78;font:800 8px Inter;letter-spacing:1.7px}.landing h2{position:relative;font:900 clamp(60px,7vw,94px)/.8 'Barlow Condensed';letter-spacing:-1px;margin:22px 0 22px;max-width:720px}.landing h2 em{font-style:normal;color:#c5a558}.landing p{position:relative;max-width:620px;color:#969ba3;font-size:13px;line-height:1.7;margin:0 0 26px}.landing-actions{display:flex;gap:9px;position:relative}.landing-footer{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #33332f;background:rgba(7,8,10,.45)}.landing-footer div{padding:16px 20px;border-right:1px solid #292c31}.landing-footer div:last-child{border-right:0}.landing-footer b{font:800 27px 'Barlow Condensed';display:block}.landing-footer span{font-size:8px;text-transform:uppercase;letter-spacing:1px;color:#6e747b}
.section-head{display:flex;align-items:end;justify-content:space-between;margin:34px 0 13px}.section-head h3{font:800 25px 'Barlow Condensed';margin:0}.faction-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.faction-tile{position:relative;min-height:112px;border:1px solid #292e35;background:linear-gradient(145deg,#13161b,#0f1115);color:#eee;text-align:left;padding:16px;cursor:pointer;overflow:hidden;transition:.18s}.faction-tile:hover{border-color:#645635;background:linear-gradient(145deg,#1b1914,#111419);transform:translateY(-2px)}.faction-sigil{display:grid;place-items:center;width:34px;height:34px;border:1px solid #484333;background:#17150f;color:#c6a957;font-size:17px;margin-bottom:12px}.faction-sigil.small{width:27px;height:27px;font-size:14px;display:inline-grid;margin:0}.faction-name{display:block;font:800 20px 'Barlow Condensed';line-height:1}.faction-sub{display:block;color:#6f757d;font-size:8px;text-transform:uppercase;letter-spacing:.8px;margin-top:7px}.faction-arrow{position:absolute;right:13px;bottom:13px;color:#686d75;font-size:15px}
.page-intro{display:flex;justify-content:space-between;align-items:end;margin-bottom:17px}.page-intro h2,.create-copy h2{font:900 48px 'Barlow Condensed';margin:0 0 4px}.page-intro p,.create-copy p{color:#80868f;font-size:12px;margin:0}.roster-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.roster-card-v4{border:1px solid #292e35;background:linear-gradient(145deg,#13161b,#0f1115);transition:.18s}.roster-card-v4:hover{border-color:#504733;transform:translateY(-2px)}.roster-banner{padding:9px 13px;border-bottom:1px solid #282c33;color:#9b9fa5;font-size:8px;text-transform:uppercase;letter-spacing:1.2px;display:flex;align-items:center;gap:8px}.roster-card-body{padding:18px;display:flex;align-items:center;justify-content:space-between;gap:15px}.roster-card-body h3{font:800 27px 'Barlow Condensed';margin:0 0 7px}.roster-meta{display:flex;gap:13px;color:#727880;font-size:9px}.roster-card-actions{display:flex;gap:6px}.iconbtn{border:1px solid #30353c;background:#171a1f;color:#c9ccd0;padding:8px 10px;cursor:pointer;font:700 9px Inter}.empty{border:1px dashed #30343b;color:#70767e;padding:35px;text-align:center;font-size:12px}.empty.large{min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}.empty.large strong{font:800 28px 'Barlow Condensed';color:#aaa}.empty.compact{padding:22px;font-size:10px}
.create-shell{display:grid;grid-template-columns:.7fr 1.3fr;gap:14px;min-height:650px}.create-copy{border:1px solid #2d3036;background:linear-gradient(145deg,#15181d,#0e1013);padding:42px;position:relative;overflow:hidden}.create-copy:after{content:'01';position:absolute;right:-10px;bottom:-65px;font:900 260px/1 'Barlow Condensed';color:rgba(214,180,93,.035)}.create-copy h2{font-size:64px;line-height:.82;margin-top:18px;position:relative}.create-copy p{position:relative;line-height:1.7;max-width:390px;margin-top:22px}.create-rule{position:relative;display:flex;gap:13px;align-items:center;margin-top:27px}.create-rule>span{font:800 12px 'Barlow Condensed';color:#c3a65d;border:1px solid #4b422f;width:29px;height:29px;display:grid;place-items:center}.create-rule b{display:block;font:800 15px 'Barlow Condensed'}.create-rule small{display:block;color:#6f757d;font-size:8px;margin-top:2px}.create-panel{border:1px solid #30343a;background:#101317;padding:22px}.panel-head{display:flex;justify-content:space-between;align-items:end;padding:5px 2px 17px;border-bottom:1px solid #292d34}.panel-head h3{font:800 30px 'Barlow Condensed';margin:0}.step-count{font:800 8px Inter;color:#686e77;letter-spacing:1px}.faction-select-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;padding:15px 0}.faction-choice{border:1px solid #282d34;background:#14171b;color:#ddd;padding:12px;display:flex;align-items:center;gap:11px;text-align:left;cursor:pointer;min-height:62px;transition:.16s}.faction-choice:hover{border-color:#514832}.faction-choice.selected{border-color:#8b733c;background:linear-gradient(90deg,#211e17,#16191d);box-shadow:inset 2px 0 var(--accent)}.choice-sigil{width:31px;height:31px;display:grid;place-items:center;border:1px solid #454032;color:#c5a85c;background:#17150f;font-size:15px}.faction-choice b{display:block;font:800 15px 'Barlow Condensed'}.faction-choice small{display:block;color:#686e76;font-size:8px;margin-top:3px}.faction-choice i{margin-left:auto;color:#5d636b;font-style:normal;font-size:18px}.name-step{border-top:1px solid #292d34;padding-top:18px}.name-step label,.field label{display:block;color:#777d85;font:800 8px Inter;text-transform:uppercase;letter-spacing:1px;margin-bottom:7px}.name-step input,.search,.select{width:100%;border:1px solid #2c3139;background:#0c0f12;color:#e4e5e4;padding:13px 12px;outline:none;font:500 12px Inter}.name-step input:focus,.search:focus,.select:focus{border-color:#6c5b38}.name-step .button{margin-top:10px}
.warroom-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.faction-line{display:flex;align-items:center;gap:8px;color:#878d95;font:800 8px Inter;text-transform:uppercase;letter-spacing:1.2px}.warroom-head h2{font:900 50px/1 'Barlow Condensed';margin:8px 0}.warroom-actions{display:flex;gap:7px}.warroom-grid{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:13px}.warroom-main{min-width:0}.recruit-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:10px}.recruit-head h3{font:800 25px 'Barlow Condensed';margin:0}.recruit-filters{display:flex;gap:7px;width:420px}.select{max-width:170px}.fighter-pool{display:grid;gap:8px}.fighter-card-v4{border:1px solid #2a2f36;background:linear-gradient(145deg,#13161b,#0e1014);padding:17px 18px;transition:.16s}.fighter-card-v4:hover{border-color:#4a4333;box-shadow:0 12px 35px rgba(0,0,0,.2)}.fighter-top{display:flex;justify-content:space-between;gap:14px;align-items:center}.fighter-ident{display:flex;align-items:center;gap:12px}.fighter-ident .fighter-sigil{margin:0}.fighter-sigil{width:39px;height:39px;border:1px solid #484333;background:#17150f;color:#c6a957;display:grid;place-items:center;font-size:18px;flex:none}.fighter-name-line{display:flex;align-items:center;gap:8px}.fighter-name-line h4{font:800 25px 'Barlow Condensed';margin:0}.role-badge{border:1px solid #383d45;padding:4px 6px;font:800 7px Inter;letter-spacing:.7px;text-transform:uppercase;color:#aab0b7}.role-leader{color:#dec26e;border-color:#5a4c2e}.role-champion{color:#c4a677;border-color:#4f4535}.role-raw-recruit{color:#9db8a4;border-color:#34473a}.fighter-subline{font-size:8px;color:#6d737b;text-transform:uppercase;letter-spacing:.7px;margin-top:4px}.recruit-btn{min-width:90px}.profile-v4{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:15px 0}.profile-group-v4{border:1px solid #292e35;background:#0c0f12}.profile-group-title-v4{padding:6px 8px;border-bottom:1px solid #252a31;color:#686f7