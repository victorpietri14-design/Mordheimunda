.chosen-sigil{font-size:12px;color:#c3a65c;width:18px;text-align:center}.chosen-info{min-width:0;flex:1}.chosen-info b{display:block;font:800 14px 'Barlow Condensed';white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chosen-info small{display:block;color:#626971;font-size:7px;text-transform:uppercase;letter-spacing:.5px}.chosen-v4>strong{font:800 13px 'Barlow Condensed';color:#bda15a}.chosen-v4>button{border:0;background:transparent;color:#6b7178;cursor:pointer;font-size:15px}.fighter-row{display:block}
.card{border:1px solid var(--line);background:linear-gradient(145deg,#13161b,#101216);box-shadow:0 8px 30px rgba(0,0,0,.15)}.toolbar{display:flex;gap:8px;padding:14px;border-bottom:1px solid var(--line)}.armory-wrap{overflow:auto}.armory-table{width:100%;border-collapse:collapse;font-size:11px}.armory-table th,.armory-table td{padding:12px 15px;text-align:left;border-bottom:1px solid #252930}.armory-table th{color:#666d75;font-size:8px;text-transform:uppercase;letter-spacing:1px}.codex-layout{display:grid;grid-template-columns:230px minmax(0,1fr);gap:12px}.codex-nav{padding:8px;align-self:start}.codex-nav button{width:100%;text-align:left;border:0;background:transparent;color:#777e87;padding:10px;cursor:pointer;font:700 9px Inter}.codex-nav button.active{background:#1c1a15;color:#d5b15a}.codex-content{padding:14px}.rule-search{margin-bottom:12px}.book-page{border:1px solid #292e35;background:#0d1013;padding:14px;margin-bottom:8px}.book-page h4{font:800 15px 'Barlow Condensed';margin:0 0 9px;color:#bba05c}.book-page pre{white-space:pre-wrap;color:#888e96;font:10px/1.5 Inter;margin:0}.notice{border:1px solid #3b372d;background:#17150f;color:#aaa08b;padding:12px;font-size:10px;line-height:1.5;margin-top:12px}.toast{position:fixed;right:24px;bottom:24px;z-index:200;background:#191c21;border:1px solid #464b52;color:#eee;padding:12px 16px;box-shadow:var(--shadow);font:700 10px Inter}.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:grid;place-items:center;z-index:100}.modal.hidden{display:none}.modal-card{width:min(560px,calc(100% - 30px));background:#111419;border:1px solid #3a3f47;padding:22px;position:relative}.modal-close{position:absolute;right:10px;top:8px;border:0;background:transparent;color:#777;font-size:24px;cursor:pointer}
@media(max-width:1100px){.sidebar{width:210px}.main{margin-left:210px;padding:24px}.faction-grid{grid-template-columns:repeat(3,1fr)}.warroom-grid{grid-template-columns:1fr}.roster-rail{order:-1}.sticky{position:static}.create-shell{grid-template-columns:1fr}.create-copy{min-height:300px}.roster-grid{grid-template-columns:1fr}}
@media(max-width:760px){.sidebar{position:static;width:auto;height:auto;padding:10px;display:block;border-right:0;border-bottom:1px solid #252930}.brand{padding:5px}.source-pill,.side-bottom{display:none}nav{display:flex;overflow:auto;margin-top:6px}.nav{white-space:nowrap;padding:9px}.nav span{display:none}.nav i{margin:0}.main{margin-left:0;padding:18px 12px 50px}.topbar{height:auto;margin-bottom:18px}.top-actions{display:none}.topbar h1{font-size:29px}.landing-art{padding:40px 25px 30px;min-height:390px}.landing h2{font-size:56px}.landing-watermark{font-size:180px}.landing-footer{grid-template-columns:repeat(2,1fr)}.faction-grid{grid-template-columns:repeat(2,1fr)}.create-copy{padding:28px}.create-copy h2{font-size:54px}.faction-select-grid{grid-template-columns:1fr}.fighter-top{align-items:start}.fighter-name-line{display:block}.fighter-name-line .role-badge{display:inline-block;margin-top:5px}.profile-v4{grid-template-columns:1fr}.recruit-head{display:block}.recruit-filters{width:auto;margin-top:10px}.recruit-filters .select{max-width:none}.fighter-bottom{display:block}.details-tags{margin-top:8px}.warroom-head{display:block}.warroom-actions{margin-top:12px}.page-intro{display:block}.page-intro .button{margin-top:12px}}
/* V5 roster UX: sober profiles + gang tabs + fighter sheet */
.gang-tabs{display:flex;gap:4px;border-bottom:1px solid #2a2e34;margin-bottom:18px}
.gang-tab{appearance:none;border:0;border-bottom:2px solid transparent;background:transparent;color:#707780;padding:11px 14px 10px;cursor:pointer;font:800 10px Inter;text-transform:uppercase;letter-spacing:.7px}
.gang-tab:hover{color:#c9cbd0}.gang-tab.active{color:#e1c26e;border-bottom-color:#b08e49}.gang-tab span{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;margin-left:5px;border:1px solid #3a3529;font-size:8px;color:#c8a95c}
.roster-toolbar{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.roster-toolbar h3{font:800 28px 'Barlow Condensed';margin:0}.roster-toolbar p,.recruit-head p{margin:5px 0 0;color:#737a83;font-size:10px}.roster-sections{display:grid;gap:22px}.section-label{display:flex;align-items:center;gap:7px;color:#737982;font:800 8px Inter;letter-spacing:1.2px;margin-bottom:7px}.section-label span{display:grid;place-items:center;min-width:17px;height:17px;border:1px solid #333840;color:#bba05b;font-size:8px}.fighter-list{display:grid;gap:7px}
/* one sober profile row: stat name, divider, value */
.profile-simple{margin:15px 0}.profile-row{display:grid;grid-template-columns:repeat(12,minmax(38px,1fr));border:1px solid #2a2f36;background:#0b0e11}.profile-stat{min-width:0;text-align:center;padding:7px 3px;border-right:1px solid #272c32;display:grid;grid-template-rows:14px 1px 25px;align-items:center}.profile-stat:last-child{border-right:0}.profile-stat span{font:800 8px Inter;color:#8a9098;letter-spacing:.2px}.profile-stat i{height:1px;width:60%;margin:auto;background:#3a3f46}.profile-stat b{font:900 23px/1 'Barlow Condensed';color:#f0f0ed}.owned-card{width:100%;text-align:left;cursor:pointer;color:inherit}.owned-card:hover{border-color:#645536;transform:translateY(-1px)}.card-chevron{font:400 30px 'Barlow Condensed';color:#676e77}.recruit-select-row{display:flex;gap:10px;margin:12px 0 14px}.recruit-select-row label{display:block;min-width:190px;color:#777e86;font:800 8px Inter;text-transform:uppercase;letter-spacing:1px}.recruit-select-row .select,.recruit-select-row .search{margin-top:6px}.recruit-select-row .grow{flex:1}.chosen-v4{width:100%;text-align:left;cursor:pointer}.chosen-v4:hover{border-color:#5a4d35}.chosen-open{font:400 18px 'Barlow Condensed';color:#5d646d}.fighter-sheet{min-width:min(860px,calc(100vw - 80px))}.sheet-head{display:flex;justify-content:space-between;align-items:start;gap:20px;padding-bottom:15px;border-bottom:1px solid #2a2e34}.sheet-name{display:block;background:transparent;border:0;border-bottom:1px solid #3a3e45;color:#eee;padding:0 0 4px;width:min(520px,70vw);font:900 42px/1 'Barlow Condensed';outline:none}.sheet-name:focus{border-color:#b08e49}.sheet-sub{color:#777e86;font:700 9px Inter;text-transform:uppercase;letter-spacing:.8px;margin-top:7px}.sheet-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:10px}.sheet-block{border:1px solid #292e35;background:#0d1013;padding:15px}.sheet-block-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #292e35;padding-bottom:8px;margin-bottom:10px}.sheet-block-head h4{margin:0;font:800 20px 'Barlow Condensed'}.sheet-block-head span{color:#bda15a;font:800 9px Inter}.sheet-help{font-size:9px;color:#6f767e;line-height:1.5}.equipment-list{display:grid;gap:5px;margin:10px 0}.equipment-item{display:flex;align-items:center;gap:8px;border:1px solid #292e35;background:#14171b;padding:8px}.equipment-item span{flex:1;font:700 12px 'Barlow Condensed'}.equipment-item strong{font:800 11px 'Barlow Condensed';color:#c1a25a}.equipment-item button{border:0;background:transparent;color:#747b82;cursor:pointer;font-size:16px}.equipment-add{display:flex;gap:6px;margin:9px 0 13px}.equipment-add .select{flex:1}.rule-copy{font-size:10px;color:#a2a7ad;line-height:1.55}.muted{color:#626971}.field{margin-top:15px}.field textarea{width:100%;box-sizing:border-box;background:#0a0d10;border:1px solid #2b3037;color:#ddd;padding:9px;font:500 10px Inter;resize:vertical;outline:none}.sheet-footer{display:flex;justify-content:space-between;align-items:center;margin-top:10px;padding-top:12px;border-top:1px solid #2a2e34}.sheet-footer strong{font:800 18px 'Barlow Condensed';color:#c5a75d}
@media(max-width:900px){.profile-row{grid-template-columns:repeat(6,1fr)}.profile-stat:nth-child(6){border-right:0}.sheet-grid{grid-template-columns:1fr}.fighter-sheet{min-width:0}.sheet-name{width:100%;font-size:34px}}
@media(max-width:600px){.roster-toolbar{display:block}.roster-toolbar .button{margin-top:10px}.recruit-select-row{display:block}.recruit-select-row label{margin-bottom:10px}.profile-row{grid-template-columns:repeat(4,1fr)}.profile-stat:nth-child(4n){border-right:0}.fighter-top{gap:8px}.fighter-name-line h4{font-size:22px}}

/* V6: fighter card as a side window + Munda-style equipment lists */
.modal{justify-items:end;background:rgba(0,0,0,.68);backdrop-filter:blur(2px)}
.modal-card{height:100vh;max-height:100vh;width:min(900px,calc(100vw - 28px));box-sizing:border-box;padding:26px 24px 30px;overflow:auto;border-width:0 0 0 1px;border-color:#3a3f47;box-shadow:-20px 0 60px rgba(0,0,0,.42);animation:sheetIn .18s ease-out}
@keyframes sheetIn{from{transform:translateX(28px);opacity:.6}to{transform:translateX(0);opacity:1}}
.modal-close{position:sticky;float:right;right:auto;top:0;z-index:3;width:34px;height:34px;border:1px solid #343941;background:#15181d;color:#a1a6ac;font-size:22px;line-height:1;cursor:pointer}
.fighter-sheet{min-width:0;padding-top:4px}.fighter-sheet .profile-simple{margin-top:20px}
.equipment-picker{border:1px solid #292e35;background:#0b0e11;margin-top:12px}.equipment-tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #292e35}.equipment-tab{border:0;border-right:1px solid #292e35;background:#101318;color:#6f767e;padding:11px 8px;cursor:pointer;font:800 9px Inter;text-transform:uppercase;letter-spacing:.55px}.equipment-tab:last-child{border-right:0}.equipment-tab:hover{color:#c9cbd0}.equipment-tab.active{background:#1b1812;color:#ddbf70;box-shadow:inset 0 -2px 0 #b08e49}.equipment-tab span{display:inline-grid;place-items:center;margin-left:6px;min-width:17px;height:16px;border:1px solid #3a3529;color:#bda15a;font-size:7px}.equipment-categories{display:flex;gap:4px;padding:7px;border-bottom:1px solid #252a30;overflow:auto}.equipment-cat{white-space:nowrap;border:1px solid #292e35;background:#111419;color:#6f767e;padding:6px 9px;cursor:pointer;font:800 8px Inter;text-transform:uppercase}.equipment-cat:hover{color:#c9cbd0}.equipment-cat.active{border-color:#5b4a2d;background:#1a1711;color:#c9ab60}.equipment-market-list{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:7px;max-height:260px;overflow:auto}.equipment-choice{display:flex;align-items:center;gap:8px;text-align:left;border:1px solid #252a30;background:#12151a;color:#ddd;padding:8px 9px;cursor:pointer}.equipment-choice:hover{border-color:#5b4a2d;background:#171a1f}.equipment-choice span{min-width:0;flex:1}.equipment-choice b{display:block;font:700 12px 'Barlow Condensed';white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.equipment-choice small{display:block;color:#666d75;font:700 7px Inter;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}.equipment-choice strong{font:800 10px 'Barlow Condensed';color:#c1a25a;white-space:nowrap}
@media(max-width:700px){.modal-card{width:100vw;padding:20px 14px 25px}.equipment-market-list{grid-template-columns:1fr}.equipment-tabs{grid-template-columns:1fr}.equipment-tab{border-right:0;border-bottom:1px solid #292e35}.equipment-tab:last-child{border-bottom:0}}

/* V8 — fiche pleine page, trésor, achat confirmé et cartes enrichies */
.roster-card-clickable{cursor:pointer;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}
.roster-card-clickable:hover{transform:translateY(-2px);border-color:#665638;box-shadow:0 12px 30px rgba(0,0,0,.18)}
.warband-gold{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 16px;margin:0 0 18px;border:1px solid #292e35;background:#0d1013}
.warband-gold>div:first-child{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}.warband-gold strong{font:900 27px 'Barlow Condensed';color:#d2b66b}.warband-gold small{color:#676e76;font-size:9px}.gold-controls{display:flex;align-items:end;gap:6px;flex-wrap:wrap}.gold-btn{border:1px solid #373c43;background:#15191e;color:#c9cdd1;padding:9px 12px;cursor:pointer;font:800 10px Inter}.gold-btn:hover{border-color:#705e38;color:#e0c47b}.gold-controls label{display:grid;gap:4px;color:#777e86;font:800 8px Inter;text-transform:uppercase;letter-spacing:.7px}.gold-controls input{width:70px;background:#0a0d10;border:1px solid #30353c;color:#eee;padding:8px;font:700 11px Inter}
.fighter-card-v4.owned-card{position:relative;display:block;border:1px solid #292e35;background:#0d1013;padding:13px 100px 13px 14px;min-height:0;overflow:hidden}.fighter-card-v4.owned-card:hover{border-color:#665638}.fighter-card-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}.fighter-card-sections>div{border-top:1px solid #252a30;padding-top:8px}.fighter-card-sections p{margin:4px 0 0;color:#969ca3;font-size:9px;line-height:1.45}.card-weapons{margin:22px 0 0;padding-top:4px}.weapon-profile{border:1px solid #292e35;background:#101419;margin-top:7px}.weapon-profile-title{padding:7px 9px;border-bottom:1px solid #292e35;color:#dedfdc;font:800 14px 'Barlow Condensed'}.weapon-profile-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.weapon-profile-grid>span{padding:7px 8px;border-right:1px solid #292e35;color:#697079;font:700 7px Inter;text-transform:uppercase;letter-spacing:.5px}.weapon-profile-grid>span:nth-last-child(1){border-right:0}.weapon-profile-grid b{display:block;margin-top:2px;color:#ddd;font:800 12px 'Barlow Condensed';text-transform:none;letter-spacing:0}.weapon-profile-grid .weapon-traits{grid-column:span 1}.fighter-value-circle{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:68px;height:68px;border:2px solid #8d7441;border-radius:50%;background:#15130f;display:grid;place-items:center;align-content:center;box-sizing:border-box;text-align:center;z-index:1}.fighter-value-circle span{font:800 7px Inter;letter-spacing:1px;color:#8c846f}.fighter-value-circle strong{font:900 24px/1 'Barlow Condensed';color:#e2c677}.fighter-value-circle em{font:700 7px Inter;color:#8c846f;font-style:normal}.hero-value{position:static;transform:none;width:94px;height:94px;flex:0 0 94px}.hero-value strong{font-size:32px}.fighter-title-row{display:flex;align-items:center;gap:12px}.fighter-page{max-width:1180px;margin:0 auto;padding-bottom:40px}.fighter-page-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.fighter-page-header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 24px;border:1px solid #2a2f36;background:#0c0f12}.fighter-page-header .sheet-name{width:min(700px,65vw)}.fighter-page>.profile-simple{margin:18px 0 26px}.fighter-page .profile-row{background:#0c0f12}.fighter-page .profile-stat.mental-stat{background:#171613}.fighter-page .profile-stat.mental-stat span{color:#aa986d}.fighter-page .profile-xp{min-width:54px;text-align:center;padding:7px 5px;background:#211c12;display:grid;grid-template-rows:14px 1px 25px;align-items:center}.fighter-page .profile-xp span{font:800 8px Inter;color:#d0b46a}.fighter-page .profile-xp i{height:1px;width:60%;margin:auto;background:#66532e}.fighter-page .profile-xp b{font:900 23px/1 'Barlow Condensed';color:#e0c06d}.fighter-detail-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.fighter-detail-grid .sheet-block{min-width:0}.weapons-block{grid-column:1/-1}.equipment-add-block{grid-column:1/-1}.field-inline{display:flex}.field-inline label{display:grid;gap:6px;color:#777e86;font:800 8px Inter;text-transform:uppercase;letter-spacing:.7px}.field-inline input{width:90px;background:#0a0d10;border:1px solid #30353c;color:#eee;padding:9px;font:800 14px 'Barlow Condensed'}.tag-editor{display:flex;gap:5px;flex-wrap:wrap;min-height:24px}.tag-editor span{display:inline-flex;align-items:center;gap:5px;border:1px solid #343941;background:#15191e;padding:5px 7px;color:#c8cbd0;font:700 10px 'Barlow Condensed'}.tag-editor button{border:0;background:transparent;color:#767d85;cursor:pointer}.inline-add{display:flex;gap:6px;margin-top:9px}.inline-add input{flex:1;min-width:0;background:#0a0d10;border:1px solid #30353c;color:#eee;padding:9px;outline:none}.wide-textarea{width:100%;box-sizing:border-box;background:#0a0d10;border:1px solid #30353c;color:#ddd;padding:10px;font:500 10px Inter;resize:vertical;outline:none}.danger-outline{border:1px solid #7a3333;background:transparent;color:#d97f7f;padding:9px 12px;cursor:pointer;font:800 9px Inter;text-transform:uppercase}.danger-outline:hover{background:#2a1414}.big-delete{display:block;width:100%;border:2px solid #9d3838;background:#6f1f1f;color:#fff;padding:16px 12px;margin:20px 0 8px;cursor:pointer;font:900 11px Inter;letter-spacing:.7px}.big-delete:hover{background:#8b2727}.purchase-dialog,.delete-dialog{max-width:620px;margin:0 auto;padding:8px}.purchase-dialog h2,.delete-dialog h2{font:900 34px 'Barlow Condensed';margin:4px 0 8px}.purchase-dialog p,.delete-dialog p{color:#8c939b;font-size:10px;line-height:1.55}.purchase-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.purchase-grid label{display:grid;gap:6px;color:#818891;font:800 8px Inter;text-transform:uppercase;letter-spacing:.7px}.purchase-grid input{background:#0a0d10;border:1px solid #343941;color:#eee;padding:11px;font:800 16px 'Barlow Condensed'}.toggle-line{display:flex;align-items:center;gap:8px;padding:10px;border:1px solid #292e35;background:#101318;color:#aaa;font:700 9px Inter}.toggle-line input{accent-color:#b08e49}.purchase-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.fighter-page .equipment-picker{margin-top:10px}.fighter-page .equipment-market-list{max-height:390px}
/* The purchase/delete confirmations are dialogs; the warrior sheet itself is no longer a modal. */
.modal{justify-items:center;align-items:center;background:rgba(0,0,0,.72)}.modal-card{height:auto;max-height:calc(100vh - 32px);width:min(680px,calc(100vw - 28px));padding:24px;overflow:auto;border:1px solid #3a3f47;box-shadow:0 30px 90px rgba(0,0,0,.5);animation:modalIn .16s ease-out}.modal-close{position:absolute;right:10px;top:10px;float:none}.modal-card #modalContent{padding-top:4px}@keyframes modalIn{from{transform:translateY(8px);opacity:.4}to{transform:translateY(0);opacity:1}}
@media(max-width:900px){.warband-gold{align-items:flex-start;flex-direction:column}.fighter-detail-grid{grid-template-columns:1fr}.fighter-card-sections{grid-template-columns:1fr}.fighter-page-header{align-items:flex-start}.hero-value{width:78px;height:78px;flex-basis:78px}.hero-value strong{font-size:27px}.fighter-page .profile-row{grid-template-columns:repeat(6,1fr)}.fighter-page .profile-stat:nth-child(6){border-right:0}.fighter-page .profile-stat.mental-stat{background:#171613}.fighter-page .profile-xp{grid-column:span 1}.fighter-page .fighter-title-row{flex-wrap:wrap}.fighter-page .sheet-name{width:100%}}
@media(max-width:600px){.gold-controls{width:100%}.gold-btn{flex:1}.gold-controls label{flex:0 0 75px}.fighter-page{padding:0 2px 30px}.fighter-page-top{gap:8px;align-items:flex-start}.fighter-page-top .button{font-size:8px}.fighter-page-header{padding:16px 13px;display:block}.fighter-page-header .hero-value{margin:16px 0 0}.fighter-page .profile-row{grid-template-columns:repeat(4,1fr)}.fighter-page .profile-stat:nth-child(4n){border-right:0}.fighter-page .profile-stat.mental-stat{background:#171613}.fighter-page .profile-xp{grid-column:span 4}.fighter-card-v4.owned-card{padding-right:88px}.fighter-value-circle{right:9px;width:58px;height:58px}.fighter-value-circle strong{font-size:20px}.weapon-profile-grid{grid-template-columns:repeat(2,1fr)}.weapon-profile-grid>span:nth-child(2){border-right:0}.weapon-profile-grid .weapon-traits{grid-column:1/-1;border-top:1px solid #292e35}.purchase-grid{grid-template-columns:1fr}.purchase-actions{display:grid;grid-template-columns:1fr}.modal-card{padding:20px 14px 22px}}
