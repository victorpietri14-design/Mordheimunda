:root{--bg:#0a0b0d;--panel:#111419;--panel2:#171a20;--line:#2a2f38;--text:#e8e9e6;--muted:#9298a1;--accent:#d5b15a;--accent2:#8e6b28;--danger:#d65c55;--ok:#78b98d;--shadow:0 18px 50px rgba(0,0,0,.35)}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 75% -10%,#27251d 0,#0a0b0d 38%),#0a0b0d;color:var(--text);font-family:Inter,system-ui,sans-serif}body{overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.04;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");z-index:99}.sidebar{position:fixed;left:0;top:0;bottom:0;width:252px;background:linear-gradient(180deg,#101216,#0b0c0f);border-right:1px solid var(--line);padding:24px 16px;display:flex;flex-direction:column;z-index:10}.brand{display:flex;align-items:center;gap:12px;padding:4px 8px 24px}.brand-mark{width:40px;height:40px;border:1px solid #5d5236;display:grid;place-items:center;font:800 26px 'Barlow Condensed';color:var(--accent);background:linear-gradient(135deg,#242018,#111)}.brand strong,.brand span{display:block}.brand strong{font:800 25px 'Barlow Condensed';letter-spacing:1.2px}.brand span{font-size:9px;letter-spacing:3px;color:var(--muted);margin-top:-2px}.source-pill{font:600 9px Inter;letter-spacing:.7px;color:#bdb49e;border:1px solid #38332a;padding:8px 9px;margin:0 8px 18px;background:#15130f}.source-pill span{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:7px}nav{display:grid;gap:5px}.nav{border:1px solid transparent;background:transparent;color:#9ea3ab;padding:13px 11px;text-align:left;display:flex;align-items:center;gap:12px;border-radius:4px;cursor:pointer;font:600 13px Inter;transition:.2s}.nav i{font-style:normal;width:17px;text-align:center;color:#737983}.nav:hover{background:#17191e;color:#e7e8e6}.nav.active{background:linear-gradient(90deg,#1d1b16,#15161a);border-color:#3b362b;color:#fff}.nav.active i{color:var(--accent)}.side-bottom{margin-top:auto}.version{font:600 8px 'Barlow Condensed';letter-spacing:1.4px;color:#676c73;padding:0 9px 10px}.ghost{width:100%;border:1px solid var(--line);background:transparent;color:#777d85;padding:9px;cursor:pointer}.main{margin-left:252px;min-height:100vh;padding:28px 38px 60px}.topbar{height:62px;display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:25px}.eyebrow{font:700 9px Inter;letter-spacing:2px;color:#6f747d;margin-bottom:3px}.topbar h1{font:700 34px 'Barlow Condensed';margin:0;letter-spacing:.3px}.top-actions{display:flex;gap:8px}.button{border:1px solid var(--line);padding:10px 15px;color:#ddd;background:#171a1f;cursor:pointer;font:700 11px Inter;text-transform:uppercase;letter-spacing:.7px;border-radius:3px}.button:hover{filter:brightness(1.15)}.button.primary{background:linear-gradient(180deg,#d2b25e,#a8873e);border-color:#d6b963;color:#17130a}.button.secondary{background:#14171c}.button.danger{border-color:#63302e;color:#e77a72;background:#1b1213}.hero{position:relative;overflow:hidden;border:1px solid #39362d;background:linear-gradient(110deg,rgba(36,33,26,.97),rgba(16,18,22,.96) 70%);padding:42px 42px 40px;box-shadow:var(--shadow);min-height:300px}.hero:after{content:'M17';position:absolute;right:30px;bottom:-44px;font:800 190px 'Barlow Condensed';color:rgba(213,177,90,.045);pointer-events:none}.tag{display:inline-block;border:1px solid #4d4635;background:#18160f;color:#c9af6d;font:700 9px Inter;letter-spacing:1.4px;padding:6px 8px;text-transform:uppercase}.hero h2{font:800 clamp(48px,6vw,76px)/.85 'Barlow Condensed';max-width:650px;margin:19px 0;color:#eee}.hero p{max-width:650px;color:#9da1a8;line-height:1.65;font-size:13px;margin:0 0 25px}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap: