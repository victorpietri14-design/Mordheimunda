lood starts with no equipment. They may purchase\nClose Combat Weapons, Mountainguard Equipment, Special                     Close Combat Weapons, Mountainguard Equipment, Special\nweapons, Armour, and Wargear from the Averlander                           weapons, Armour, and Wargear from the Averlander\nEquipment List.                                                            Equipment List.\nSPECIAL RULES:                                                             SPECIAL RULES:\nRace (Human), Champion                                                     Race (Human ), Raw Recruit.\nSTARTING SKILL:","equipment":["Axe","Club","Dagger","Great Axe","Great Hammer","Great Sword","Halberd","Hammer or Mace","Morning Star","Spear","Staff","Sword","Heavy armour","Light armour","Bow","Crossbow","Long bow","Short bow","Blunderbuss","Duelling Pistol","Handgun","Hochland long rifle","Pistol","Buckler","Shield","Hunting arrows","Lantern","Man trap","Rope and hook"],"displayName":"Averland","warriors":[{"id":"mercenary-captain","name":"Mercenary Captain","type":"Leader","max":1,"cost":125,"profile":[4,4,4,4,3,2,4,3,8,8,7,7],"access":"Averlander Equipment List"},{"id":"sergeant","name":"Sergeant","type":"Champion","max":2,"cost":80,"profile":[4,4,3,3,3,2,4,2,8,7,7,7],"access":"Averlander Equipment List"},{"id":"bergjager","name":"Bergjager","type":"Champion","max":2,"cost":80,"profile":[4,3,4,3,3,2,4,2,7,8,7,7],"access":"Averlander Equipment List"},{"id":"youngblood","name":"Youngblood","type":"Raw Recruit","max":2,"cost":20,"profile":[4,2,2,3,3,1,3,1,6,6,6,6],"access":"Averlander Equipment List"},{"id":"mountainguard","name":"Mountainguard","type":"Henchman","max":5,"cost":35,"profile":[4,4,3,3,3,1,3,1,7,7,7,7],"access":"Averlander Equipment List"},{"id":"marksman","name":"Marksman","type":"Henchman","max":7,"cost":35,"profile":[4,3,3,3,3,1,3,1,7,7,7,7],"access":"Averlander Equipment List"},{"id":"halfling-scout","name":"Halfling Scout","type":"Henchman","max":3,"cost":20,"prof